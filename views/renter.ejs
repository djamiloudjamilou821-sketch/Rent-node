<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Renter Profile | <%= renter.name %></title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        },
                    }
                }
            }
        }
    </script>

    <style>
        .custom-shadow {
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 10px -2px rgba(0, 0, 0, 0.03);
        }
        .profile-gradient {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen pb-10">

    <!-- Top Navigation -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-30 px-4 py-4 md:px-8">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-4">
                <a href="/dashboard" class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-all">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <h1 class="text-xl font-bold text-slate-800 tracking-tight">Renter Profile</h1>
            </div>
            <div class="flex gap-2">
                <a href="/edit/<%= renter.id %>" class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 text-slate-600 hover:bg-amber-50 hover:text-amber-600 transition-all">
                    <i class="fa-solid fa-pen-to-square"></i>
                </a>
            </div>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto p-4 md:p-8">
        
        <!-- Profile Header Card -->
        <div class="bg-white rounded-3xl overflow-hidden custom-shadow border border-slate-100 mb-8">
            <div class="profile-gradient h-32 relative">
                <div class="absolute -bottom-12 left-8">
                    <div class="w-24 h-24 rounded-3xl bg-white p-1 shadow-lg">
                        <div class="w-full h-full rounded-[1.25rem] bg-brand-100 text-brand-700 flex items-center justify-center text-3xl font-black">
                            <%= renter.name.charAt(0).toUpperCase() %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-16 pb-8 px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <h2 class="text-3xl font-black text-slate-900"><%= renter.name %></h2>
                        <div class="flex flex-wrap items-center gap-4 mt-3 text-slate-500 text-sm">
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-phone text-brand-500"></i>
                                <%= renter.phone %>
                            </span>
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-location-dot text-brand-500"></i>
                                <%= renter.address %>
                            </span>
                        </div>
                    </div>
                    <a href="/pay/<%= renter.id %>" class="flex items-center justify-center gap-3 bg-brand-600 text-white px-8 py-4 rounded-2xl font-bold hover:bg-brand-700 transition-all shadow-lg shadow-brand-200 active:scale-95">
                        <i class="fa-solid fa-credit-card"></i>
                        Make Payment
                    </a>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Key Details -->
            <div class="md:col-span-2 space-y-6">
                <!-- Status & Info -->
                <div class="bg-white p-6 rounded-3xl border border-slate-100 custom-shadow">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-6">Lease Information</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                        <div>
                            <p class="text-xs text-slate-400 mb-1">Start Date</p>
                            <p class="font-semibold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-calendar-check text-brand-500 text-xs"></i>
                                <%= renter.start_date %>
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400 mb-1">Payment Status</p>
                            <p class="font-semibold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-hourglass-half text-brand-500 text-xs"></i>
                                <%= dueInfo %>
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400 mb-1">Current Balance</p>
                            <% if (debt > 0) { %>
                                <p class="text-xl font-black text-rose-600 flex items-center gap-2">
                                    <%= debt %> CFA
                                    <span class="text-[10px] bg-rose-50 px-2 py-0.5 rounded-full uppercase tracking-tighter">Overdue</span>
                                </p>
                            <% } else { %>
                                <p class="text-xl font-black text-emerald-600 flex items-center gap-2">
                                    0 CFA
                                    <span class="text-[10px] bg-emerald-50 px-2 py-0.5 rounded-full uppercase tracking-tighter">Paid</span>
                                </p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Payment History -->
                <div class="bg-white rounded-3xl border border-slate-100 custom-shadow overflow-hidden">
                    <div class="p-6 border-b border-slate-50 flex justify-between items-center">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider">Payment History</h3>
                        <span class="text-[10px] font-bold bg-slate-100 text-slate-500 px-2 py-1 rounded-md">
                            <%= payments ? payments.length : 0 %> RECORDS
                        </span>
                    </div>
                    
                    <% if (payments && payments.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="bg-slate-50/50">
                                    <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase">Ref</th>
                                    <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase">Amount</th>
                                    <th class="px-6 py-4 text-[10px] font-bold text-slate-400 uppercase">Date</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                <% payments.forEach((p, index) => { %>
                                <tr class="hover:bg-slate-50/30 transition-colors">
                                    <td class="px-6 py-4 text-sm text-slate-400 font-mono">#<%= index + 1 %></td>
                                    <td class="px-6 py-4 text-sm font-bold text-emerald-600"><%= p.amount %> CFA</td>
                                    <td class="px-6 py-4 text-sm text-slate-600"><%= p.payment_date %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="p-12 text-center">
                        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fa-solid fa-receipt text-slate-200 text-2xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm">No payment records found</p>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Sidebar Stats -->
            <div class="space-y-6">
                <div class="bg-white p-6 rounded-3xl border border-slate-100 custom-shadow">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-6">Quick Stats</h3>
                    
                    <div class="space-y-6">
                        <div>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2">Total Paid to Date</p>
                            <p class="text-2xl font-black text-slate-900"><%= total_paid %> <span class="text-xs font-normal text-slate-400">CFA</span></p>
                        </div>
                        
                        <div>
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2">Total Installments</p>
                            <p class="text-2xl font-black text-slate-900"><%= total_payments %></p>
                        </div>

                        <div class="pt-4 border-t border-slate-50">
                            <p class="text-[10px] text-slate-400 uppercase font-bold mb-2">Last Activity</p>
                            <% if (last_payment) { %>
                                <p class="text-sm font-semibold text-slate-700"><%= last_payment %></p>
                            <% } else { %>
                                <p class="text-sm font-semibold text-slate-400 italic">No activity yet</p>
                            <% } %>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Danger Zone (Optional) -->
        <div class="mt-12 pt-8 border-t border-slate-200">
            <a href="/delete/<%= renter.id %>" onclick="return confirm('Are you sure? This action is permanent.')" class="text-rose-400 hover:text-rose-600 text-xs font-bold flex items-center gap-2 transition-colors">
                <i class="fa-solid fa-trash-can"></i>
                Terminate Lease / Delete Renter Profile
            </a>
        </div>

    </main>

</body>
</html>
