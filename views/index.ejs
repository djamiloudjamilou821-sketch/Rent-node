<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rental Dashboard</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Professional Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS CDN for rapid professional styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        },
                    }
                }
            }
        }
    </script>

    <style>
        body {
            -webkit-tap-highlight-color: transparent;
            padding-bottom: 80px; /* Space for bottom nav */
        }
        .glass-morphism {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .custom-shadow {
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 10px -2px rgba(0, 0, 0, 0.03);
        }
        .active-nav {
            color: #2563eb;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">

    <!-- Header Section -->
    <header class="bg-brand-600 text-white pt-8 pb-12 px-6 rounded-b-[2.5rem] shadow-lg relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Rental Dashboard</h1>
                <p class="text-brand-100 text-sm mt-1 opacity-90">Welcome back, manager</p>
            </div>
            <div class="bg-white/20 p-2 rounded-full backdrop-blur-md">
                <i class="fa-solid fa-bell text-xl"></i>
            </div>
        </div>
        <!-- Decorative Circle -->
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full"></div>
    </header>

    <main class="px-4 -mt-6 relative z-20">
        <!-- Search Bar -->
        <form method="GET" action="/dashboard" class="mb-6">
            <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <i class="fa-solid fa-magnifying-glass text-slate-400 group-focus-within:text-brand-500 transition-colors"></i>
                </div>
                <input 
                    type="text" 
                    name="search" 
                    placeholder="Search by renter name..." 
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    class="block w-full pl-11 pr-4 py-3.5 bg-white border-none rounded-2xl shadow-sm focus:ring-2 focus:ring-brand-500 focus:outline-none transition-all placeholder:text-slate-400 text-slate-700"
                >
            </div>
        </form>

        <!-- Stats Overview -->
        <div class="grid grid-cols-3 gap-3 mb-8">
            <a href="/dashboard" class="group">
                <div class="bg-white p-4 rounded-2xl custom-shadow text-center transition-transform active:scale-95 border-b-4 border-slate-700">
                    <div class="text-2xl font-bold text-slate-800 leading-none"><%= total %></div>
                    <div class="text-[10px] uppercase tracking-wider font-semibold text-slate-500 mt-2">Total</div>
                </div>
            </a>
            <a href="/dashboard?filter=paid" class="group">
                <div class="bg-white p-4 rounded-2xl custom-shadow text-center transition-transform active:scale-95 border-b-4 border-emerald-500">
                    <div class="text-2xl font-bold text-emerald-600 leading-none"><%= paid %></div>
                    <div class="text-[10px] uppercase tracking-wider font-semibold text-slate-500 mt-2">Paid</div>
                </div>
            </a>
            <a href="/dashboard?filter=overdue" class="group">
                <div class="bg-white p-4 rounded-2xl custom-shadow text-center transition-transform active:scale-95 border-b-4 border-rose-500">
                    <div class="text-2xl font-bold text-rose-600 leading-none"><%= overdue %></div>
                    <div class="text-[10px] uppercase tracking-wider font-semibold text-slate-500 mt-2">Overdue</div>
                </div>
            </a>
        </div>

        <!-- Renters List -->
        <div class="space-y-4">
            <div class="flex justify-between items-center px-1">
                <h2 class="font-bold text-slate-800 text-lg">Recent Renters</h2>
                <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-1 rounded-md">See All</span>
            </div>

            <% renters.forEach(r => { %>
                <div class="bg-white rounded-2xl p-5 custom-shadow border border-slate-100 hover:border-brand-200 transition-colors group">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="font-bold text-slate-900 text-lg group-hover:text-brand-600 transition-colors"><%= r.name %></h3>
                            <div class="flex items-center text-slate-500 text-sm mt-1">
                                <i class="fa-solid fa-phone text-[10px] mr-2"></i>
                                <span><%= r.phone %></span>
                            </div>
                        </div>
                        <% if (r.status === "paid") { %>
                            <span class="bg-emerald-50 text-emerald-700 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide border border-emerald-100">
                                <i class="fa-solid fa-check mr-1"></i> Paid
                            </span>
                        <% } else { %>
                            <span class="bg-rose-50 text-rose-700 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide border border-rose-100">
                                <i class="fa-solid fa-clock mr-1"></i> Overdue
                            </span>
                        <% } %>
                    </div>

                    <div class="space-y-3 mb-5">
                        <div class="flex items-start">
                            <i class="fa-solid fa-location-dot text-slate-400 mt-1 mr-3 w-4"></i>
                            <span class="text-sm text-slate-600 leading-relaxed"><%= r.address %></span>
                        </div>
                        <div class="flex items-center">
                            <i class="fa-solid fa-calendar-day text-slate-400 mr-3 w-4"></i>
                            <span class="text-sm text-slate-600">Next Due: <span class="font-semibold text-slate-900"><%= r.dueInfo %></span></span>
                        </div>
                        <% if (r.status !== "paid") { %>
                            <div class="flex items-center p-3 bg-rose-50/50 rounded-xl border border-rose-100">
                                <i class="fa-solid fa-money-bill-wave text-rose-500 mr-3"></i>
                                <span class="text-sm font-medium text-rose-800">debt: <span class="font-bold"><%= r.debt %> CFA</span></span>
                            </div>
                        <% } %>
                    </div>

                    <a href="/renter/<%= r.id %>" class="flex items-center justify-center w-full py-3 bg-slate-50 text-slate-700 font-semibold rounded-xl hover:bg-brand-600 hover:text-white transition-all active:scale-[0.98]">
                        View Profile Details
                        <i class="fa-solid fa-chevron-right ml-2 text-xs"></i>
                    </a>
                </div>
            <% }) %>
        </div>
    </main>

    <!-- Floating Action Button -->
    

    <!-- Bottom Navigation -->
    <nav class="fixed bottom-0 left-0 right-0 glass-morphism border-t border-slate-200 px-6 py-3 flex justify-between items-center z-50">
        <a href="/home" class="flex flex-col items-center gap-1 transition-colors hover:text-brand-600 text-slate-400">
            <i class="fa-solid fa-house text-lg"></i>
            <span class="text-[10px] font-medium">Home</span>
        </a>
        <a href="/renters" class="flex flex-col items-center gap-1 transition-colors hover:text-brand-600 text-slate-400">
            <i class="fa-solid fa-users text-lg"></i>
            <span class="text-[10px] font-medium">Renters</span>
        </a>
        <a href="/money" class="flex flex-col items-center gap-1 transition-colors hover:text-brand-600 text-slate-400">
            <i class="fa-solid fa-wallet text-lg"></i>
            <span class="text-[10px] font-medium">Finance</span>
        </a>
        <a href="/verify-user" class="flex flex-col items-center gap-1 transition-colors hover:text-brand-600 text-slate-400">
            <i class="fa-solid fa-lock text-lg"></i>
            <span class="text-[10px] font-medium">Secure</span>
        </a>
    </nav>

    <script>
        // Service Worker Registration
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js')
            .then(() => console.log("SW registered"))
            .catch(err => console.log("SW failed", err));
        }

        // Active Link Highlighting (Simple Implementation)
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav a').forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('text-brand-600');
                link.classList.remove('text-slate-400');
            }
        });
    </script>

    

</body>
</html>
